# Linux runtime component lock. Release automation sources this as data; the
# installer never downloads these independently of an Asterism release.
# Update policy: one reviewed change updates version + every architecture
# digest, runs the backend conformance suite on Ubuntu and Fedora, then cuts a
# new immutable Asterism release. Running installations never auto-update a
# VMM underneath a guest.
#
# Architecture/checksum contract: every CLOUD_HYPERVISOR_*_{URL,SHA256} pair
# and the virtiofsd source tarball pin must be present and non-empty. A
# truncated lock is a packaging defect, not a partial install.

CLOUD_HYPERVISOR_VERSION=v53.0
CLOUD_HYPERVISOR_LICENSE=Apache-2.0,BSD-3-Clause
CLOUD_HYPERVISOR_SOURCE=https://github.com/cloud-hypervisor/cloud-hypervisor/tree/v53.0
CLOUD_HYPERVISOR_SOURCE_TARBALL=https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v53.0/cloud-hypervisor-v53.0.tar.xz
CLOUD_HYPERVISOR_SOURCE_SHA256=7d806fc1ee42dc4cf5af1293925ab0f741c676ccd29b7f1fa6cb798c01c51f1f
CLOUD_HYPERVISOR_X86_64_URL=https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v53.0/cloud-hypervisor-static
CLOUD_HYPERVISOR_X86_64_SHA256=448af3d4e59b22c2987f7df94c213ad40fb53a10d437e42b5ee6c4fce7c29ecc
CLOUD_HYPERVISOR_AARCH64_URL=https://github.com/cloud-hypervisor/cloud-hypervisor/releases/download/v53.0/cloud-hypervisor-static-aarch64
CLOUD_HYPERVISOR_AARCH64_SHA256=f192b510eea1c710cbc439d716bb0573c223fc463dbe3e6523788a2b7ef62850

VIRTIOFSD_VERSION=v1.14.0
VIRTIOFSD_LICENSE=Apache-2.0,BSD-3-Clause
VIRTIOFSD_SOURCE=https://gitlab.com/virtio-fs/virtiofsd/-/tree/v1.14.0
VIRTIOFSD_TARBALL=https://gitlab.com/virtio-fs/virtiofsd/-/archive/v1.14.0/virtiofsd-v1.14.0.tar.gz
VIRTIOFSD_TARBALL_SHA256=52b66e449ca583b4f050a2bff327ff812211a2c349b4130279fcfc6a64540f04
