#!/bin/sh
# Root-side boundary for Asterism's NBD attachment lane. The installer owns
# this file and sudoers names this exact path; astd never receives general
# root access or permission to invoke nbd-client directly.
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

die() {
	printf 'asterism-nbd: %s\n' "$*" >&2
	exit 2
}

caller_uid=${SUDO_UID-}
caller_gid=${SUDO_GID-}
valid_id() {
	case "$1" in '' | *[!0-9]*) return 1 ;; esac
	[ "$1" -ge 0 ]
}

# `astd` is deliberately unprivileged. sudo supplies the invoking account in
# SUDO_UID/GID; grant that account access to only the device selected for this
# attach, and restore root ownership as soon as it is detached. A missing
# sudo identity is allowed for administrator-run diagnostics, but a normal
# unprivileged daemon always reaches this path through sudo.
grant_device() {
	device=$1
	if [ -n "$caller_uid" ] || [ -n "$caller_gid" ]; then
		valid_id "$caller_uid" && valid_id "$caller_gid" ||
			die "sudo did not provide a numeric invoking uid/gid"
		if ! chown "$caller_uid:$caller_gid" "$device"; then
			"$client" -d "$device" >/dev/null 2>&1 || :
			die "could not grant the invoking account access to $device"
		fi
	fi
	if ! chmod 0600 "$device"; then
		"$client" -d "$device" >/dev/null 2>&1 || :
		die "could not restrict access to $device"
	fi
}

restore_device() {
	device=$1
	chown root:root "$device" || die "could not restore root ownership of $device"
	chmod 0600 "$device" || die "could not restore permissions on $device"
}

nbd_device() {
	case "$1" in
	/dev/nbd[0-9] | /dev/nbd[0-9][0-9]) ;;
	*) return 1 ;;
	esac
	index=${1#/dev/nbd}
	[ "$index" -le 63 ]
}

[ "$(id -u)" = "0" ] || die "must run as root through the installed sudo policy"
client=$(command -v nbd-client) || die "nbd-client is not installed"

case "${1-}" in
-d)
	if [ "$#" -ne 2 ] || ! nbd_device "$2"; then
		die "invalid detach request"
	fi
	device=$2
	"$client" "$@" || exit $?
	restore_device "$device"
	exit 0
	;;
-unix)
	[ "$#" -eq 5 ] || [ "$#" -eq 6 ] || die "invalid Unix attach request"
	case "$2" in /*) ;; *) die "the NBD Unix socket must be an absolute path" ;; esac
	nbd_device "$3" || die "the target must be /dev/nbd0 through /dev/nbd63"
	[ "$4" = "-N" ] && [ -n "$5" ] || die "the NBD export must be named"
	[ "$#" -eq 5 ] || [ "$6" = "-readonly" ] || die "invalid Unix attach options"
	;;
*)
	[ "$#" -eq 5 ] || [ "$#" -eq 6 ] || die "invalid network attach request"
	case "$1" in '' | -*) die "the NBD host must be named, not an option" ;; esac
	case "$2" in *[!0-9]* | '') die "the NBD port must be numeric" ;; esac
	[ "$2" -ge 1 ] && [ "$2" -le 65535 ] || die "the NBD port is out of range"
	nbd_device "$3" || die "the target must be /dev/nbd0 through /dev/nbd63"
	[ "$4" = "-N" ] && [ -n "$5" ] || die "the NBD export must be named"
	[ "$#" -eq 5 ] || [ "$6" = "-readonly" ] || die "invalid network attach options"
	;;
esac

"$client" "$@" || exit $?
grant_device "$3"
