{
  "name": "asterism-gui-ui",
  "private": true,
  "type": "module",
  "description": "The Asterism app's windows. React + Astryx, built to static files the webview loads off disk.",
  "scripts": {
    "theme": "astryx theme build src/theme/asterism.ts --out src/theme/asterism.theme.css",
    "build": "npm run theme && tsc --noEmit && vite build",
    "dev": "vite"
  },
  "dependencies": {
    "@astryxdesign/core": "0.4.5",
    "@stylexjs/stylex": "0.19.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.4.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
