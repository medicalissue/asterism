{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Asterism",
  "version": "0.0.2",
  "identifier": "run.asterism.desktop",
  "build": {
    "frontendDist": "./ui/dist",
    "beforeBuildCommand": "npm install --no-audit --no-fund && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Asterism menu bar app",
    "longDescription": "Menu bar control for Asterism instances: list, start and stop the instances whose compute is on this device, over the local astd socket.",
    "copyright": "Asterism contributors",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
